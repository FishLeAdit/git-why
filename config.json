{
  "repos": [
    {
      "owner": "MIC-DKFZ",
      "repo": "nnUNet",
      "since": "2022-01-01",
      "maxItems": null,
      "examples": ["Why was the default patch size changed?", "Why was ResEnc added?", "Why did the data loading switch to blosc2?"]
    },
    {
      "owner": "huggingface",
      "repo": "transformers.js",
      "since": "2022-01-01",
      "maxItems": null,
      "examples": ["Why was WebGPU support added?", "Why did the package move to @huggingface/transformers?", "Why was onnxruntime-web upgraded to 1.17?"],
      "noise": {
        "botAuthors": ["hf-security-analysis[bot]", "hf-dependantbot-rollout[bot]"],
        "skipSubjects": [
          "^\\[version\\] update to v?\\d[\\d.]*( \\(#\\d+\\))?$",
          "^bump versions$",
          "^update (readme\\.md|package-lock\\.json|package\\.json|dist files)$",
          "^formatting$"
        ]
      }
    }
  ],
  "model": "Xenova/bge-small-en-v1.5",
  "dtype": "q8",
  "pooling": "cls",
  "topK": 10,
  "noise": {
    "botAuthors": ["dependabot[bot]", "pre-commit-ci[bot]", "renovate[bot]"],
    "dropBotComments": true,
    "skipSubjects": [
      "^merge$",
      "^(bump|version bump|bump version( for release)?|bump to v?\\d[\\d.]*|bump [\\w.-]+( version)?)$",
      "^v?\\d+\\.\\d+(\\.\\d+)?( release)?$",
      "^(wip|stuff|minor stuff|minor changes|cleanup|debugging|initial|final|finished|runs|text|comment|imports|fix imports|pep8|whoopsies|no print)[.!?]*$",
      "^(bug ?fix(es)?|bugfox|bugfozx|fix(ed|es)?|typos?|fix(ed)? typos?|doc|docs|more doc)[.!?]*$",
      "^\\.+$"
    ]
  }
}
